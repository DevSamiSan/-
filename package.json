{
  "name": "saudipc",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run sitemap && tsc -b && vite build",
    "sitemap": "esbuild scripts/sitemap.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/sitemap.mjs --log-level=warning && node node_modules/.tmp/sitemap.mjs",
    "typecheck": "tsc -b && tsc -p functions",
    "lint": "oxlint",
    "preview": "npm run build && wrangler pages dev dist",
    "deploy": "npm run build && wrangler pages deploy dist --project-name saudipc --branch main"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lucide-react": "^1.52.0",
    "motion": "^14.0.0",
    "ogl": "^1.0.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261005.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.147.0"
  }
}
